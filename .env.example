# =============================================================================
# EXAMPLE ENVIRONMENT VARIABLES
# Copia este archivo como .env y ajusta los valores según tu entorno
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Para Docker usar: postgres
# Para local usar: localhost
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=observ-db
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_INTERVAL=1m

# =============================================================================
# OBSERVABILITY - TRACING (OpenTelemetry)
# =============================================================================
# Para Docker usar: jaeger:4317
# Para local usar: localhost:4317
TRACING_ENABLED=true
TRACING_SERVICE_NAME=factorit
TRACING_SERVICE_VERSION=1.0.0
TRACING_OTLP_ENDPOINT=jaeger:4317
TRACING_ENVIRONMENT=development

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
SERVICE_NAME=factorit
SERVICE_PORT=8080
SERVICE_HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================
GF_SECURITY_ADMIN_PASSWORD=admin
